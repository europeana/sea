{
  "dependencyDashboard": true,
  "extends": [
    "config:best-practices",
    ":automergeMinor",
    "security:minimumReleaseAgeNpm"
  ],
  "prConcurrentLimit": 5,
  "lockFileMaintenance": { "enabled": true },
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchDepNames": ["pnpm"],
      "groupName": "pnpm"
    }
  ]
}
