{
  "name": "@europeana/zoho-client",
  "version": "0.0.1",
  "description": "Europeana Zoho client",
  "repository": {
    "type": "git",
    "url": "https://github.com/europeana/sea"
  },
  "license": "EUPL-1.2",
  "type": "module",
  "scripts": {
    "build": "rimraf dist && rollup -c",
