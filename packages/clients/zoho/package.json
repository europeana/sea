  "dependencies": {
    "content-disposition": "catalog:"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "catalog:rollup4",
    "@rollup/plugin-terser": "catalog:rollup4",
    "@rollup/plugin-typescript": "catalog:rollup4",
    "@types/node": "catalog:types",
    "rimraf": "catalog:",
    "rollup": "catalog:rollup4",
    "typescript": "catalog:typescript5",
    "vite-tsconfig-paths": "catalog:vite7",
    "vitest": "catalog:vitest4"
  }
}
